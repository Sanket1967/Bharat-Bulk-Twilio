PORT=3001
CORS_ORIGIN=

# SMPP service credentials (user-supplied). When left blank the service falls
# back to the admin-managed smpp_settings PocketBase collection.
SMPP_HOST=
SMPP_PORT=2775
SMPP_SYSTEM_ID=
SMPP_PASSWORD=
SMPP_SOURCE_ADDR=GOOADV
SMPP_SYSTEM_TYPE=
SMPP_TPS=50

# Twilio master reseller credentials (user-supplied). These are the ONLY place
# Twilio secrets live — never expose them to the browser.
TWILIO_MASTER_SID=
TWILIO_MASTER_TOKEN=
TWILIO_DEFAULT_FROM=

# Bharat Bulk SMS OTP engine (api.bharatbulksms.com) — secure proxy target.
# Server-side only; never expose to the browser or include in API responses.
TWILIO_ENGINE_URL=
TWILIO_ENGINE_KEY=
TWILIO_ENGINE_FROM=
